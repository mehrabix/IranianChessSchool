{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "MASTERPLAN.md"],
  "shell": "C:\\Program Files\\PowerShell\\7\\pwsh.EXE",
  "model": "openrouter/deepseek/deepseek-v4",
  "lsp": {
    "typescript": {
      "command": ["npx", "-y", "typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts"]
    }
  },
  "agent": {
    "plan": {
      "mode": "primary",
      "model": "openrouter/deepseek/deepseek-v4",
      "temperature": 0.1,
      "permission": { "edit": "deny", "task": "allow", "bash": "ask" }
    },
    "test": {
      "description": "Runs tests for the IranianChessSchool project. Use when user asks to run tests, check test status, or verify code.",
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4",
      "temperature": 0.1,
      "permission": { "bash": "allow", "edit": "deny" },
      "prompt": "You are a test runner for IranianChessSchool. Run the appropriate test commands based on what the user asks. Use: pnpm test:unit for unit tests (Vitest), pnpm test:e2e for Playwright E2E tests, pnpm test:all for both, pnpm typecheck for TypeScript checking. Report results clearly."
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    }
  }
}
